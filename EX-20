        "\n",
        "# Future Sales Prediction using Linear Regression\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.metrics import mean_squared_error, r2_score\n",
        "\n",
        "# Month numbers\n",
        "X = np.arange(1, 13).reshape(-1, 1)\n",
        "\n",
        "# Monthly sales in thousands (sample data)\n",
        "y = np.array([20, 22, 25, 24, 28, 30,\n",
        "              32, 35, 34, 38, 40, 43])\n",
        "\n",
        "# Train the model\n",
        "model = LinearRegression()\n",
        "model.fit(X, y)\n",
        "\n",
        "# Predict existing sales\n",
        "pred = model.predict(X)\n",
        "\n",
        "print(\"Future Sales Prediction\")\n",
        "print(\"Mean Squared Error:\", mean_squared_error(y, pred))\n",
        "print(\"R2 Score:\", r2_score(y, pred))\n",
        "\n",
        "# Predict sales for the next 3 months\n",
        "future_months = np.array([13, 14, 15]).reshape(-1, 1)\n",
        "future_sales = model.predict(future_months)\n",
        "\n",
        "for month, sale in zip(future_months.flatten(), future_sales):\n",
        "    print(f\"Month {month}: Predicted Sales = {sale:.2f} thousand\")\n",
        "\n",
        "# Plot actual and predicted sales\n",
        "plt.scatter(X, y, color=\"blue\", label=\"Actual Sales\")\n",
        "plt.plot(X, pred, color=\"red\", label=\"Regression Line\")\n",
        "plt.plot(future_months, future_sales, \"go\",\n",
        "         label=\"Future Predictions\")\n",
        "\n",
        "plt.xlabel(\"Month\")\n",
        "plt.ylabel(\"Sales (Thousands)\")\n",
        "plt.title(\"Future Sales Prediction\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n"
      ]
    }

        "import matplotlib.pyplot as plt\n",
        "\n",
        "training_data = [\n",
        "    [\"High\", \"Loamy\", \"Medium\", \"Warm\", \"Organic\", \"Yes\"],\n",
        "    [\"High\", \"Loamy\", \"Medium\", \"Warm\", \"Organic\", \"Yes\"],\n",
        "    [\"High\", \"Clay\", \"High\", \"Warm\", \"Organic\", \"No\"],\n",
        "    [\"Medium\", \"Loamy\", \"Medium\", \"Warm\", \"Organic\", \"Yes\"],\n",
        "    [\"Low\", \"Loamy\", \"High\", \"Cool\", \"Chemical\", \"No\"],\n",
        "    [\"High\", \"Loamy\", \"Medium\", \"Warm\", \"Chemical\", \"Yes\"],\n",
        "    [\"Medium\", \"Clay\", \"Low\", \"Cool\", \"Organic\", \"No\"],\n",
        "    [\"High\", \"Loamy\", \"Medium\", \"Warm\", \"Organic\", \"Yes\"]\n",
        "]\n",
        "\n",
        "attributes = [\n",
        "    \"Sunlight\",\n",
        "    \"Soil\",\n",
        "    \"Water\",\n",
        "    \"Temperature\",\n",
        "    \"Fertilizer\"\n",
        "]\n",
        "\n",
        "def find_s(data):\n",
        "    hypothesis = None\n",
        "\n",
        "    for row in data:\n",
        "        target = row[-1]\n",
        "        example = row[:-1]\n",
        "\n",
        "        if target == \"Yes\":\n",
        "\n",
        "            if hypothesis is None:\n",
        "                hypothesis = example.copy()\n",
        "                print(\"Initial hypothesis:\", hypothesis)\n",
        "\n",
        "            else:\n",
        "                for i in range(len(hypothesis)):\n",
        "                    if hypothesis[i] != example[i]:\n",
        "                        hypothesis[i] = \"?\"\n",
        "\n",
        "                print(\"Updated hypothesis:\", hypothesis)\n",
        "\n",
        "    return hypothesis\n",
        "\n",
        "final_hypothesis = find_s(training_data)\n",
        "\n",
        "print(\"\\nFINAL MOST SPECIFIC HYPOTHESIS\")\n",
        "print(\"======================================\")\n",
        "\n",
        "for attribute, value in zip(attributes, final_hypothesis):\n",
        "    print(f\"{attribute:15} : {value}\")\n",
        "\n",
        "specificity = [\n",
        "    1 if value != \"?\" else 0\n",
        "    for value in final_hypothesis\n",
        "]\n",
        "\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "bars = plt.bar(attributes, specificity)\n",
        "\n",
        "plt.title(\"FIND-S Final Hypothesis Specificity\")\n",
        "plt.xlabel(\"Attributes\")\n",
        "plt.ylabel(\"Specific Attribute (1) / Generalized (0)\")\n",
        "plt.ylim(0, 1.2)\n",
        "\n",
        "for bar, value in zip(bars, final_hypothesis):\n",
        "    plt.text(\n",
        "        bar.get_x() + bar.get_width() / 2,\n",
        "        bar.get_height() + 0.03,\n",
        "        value,\n",
        "        ha=\"center\",\n",
        "        fontsize=11\n",
        "    )\n",
        "\n",
        "plt.xticks(rotation=20)\n",
        "plt.grid(axis=\"y\", linestyle=\"--\", alpha=0.4)\n",
        "plt.show()"
      ]
